{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "Atlas MMORPG Idle — Repomix Packed Codebase",
    "fileSummary": true,
    "directoryStructure": true,
    "includeEmptyDirectories": false,
    "showLineNumbers": false,
    "git": {
      "includeDiffs": false,
      "includeLogs": false,
      "sortByChanges": true
    }
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.vite/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.gemini/**",
      "**/coverage/**",
      "repomix-output.xml",
      "backend/server",
      "backend/cmd/server/server",
      "*.bin",
      "*.exe",
      "*.map",
      "**/target/**",
      "**/.cache/**",
      "**/.turbo/**",
      "**/.parcel-cache/**",
      "**/.eslintcache",
      "**/*.tsbuildinfo",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/tmp/**",
      "**/logs/**",
      "**/*.log",
      "**/*.dump",
      "**/*.sql.gz",
      "**/.DS_Store",
      "**/Thumbs.db"
    ]
  }
}