{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "Atlas MMORPG Idle — Repomix Packed Codebase",
    "fileSummary": true,
    "directoryStructure": true,
    "includeEmptyDirectories": false,
    "showLineNumbers": false,
    "git": {
      "includeDiffs": true,
      "includeLogs": true,
      "includeLogsCount": 50,
      "sortByChanges": true
    }
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.gemini/**",
      "**/coverage/**",
      "**/backend/server",
      "repomix-output.xml",
      "*.bin",
      "*.exe"
    ]
  }
}
